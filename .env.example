# Modèle du fichier .env : copiez-le en .env puis remplacez les valeurs d'exemple.
# Le fichier .env contient des secrets : il est exclu du dépôt Git et de l'image Docker.
# Une variable absente ou vide garde sa valeur par défaut (indiquée entre parenthèses).
# Booléens acceptés : 1/0, true/false, yes/no, oui/non.

# ---------------------------------------------------------------- Application
# Environnement : development, production ou test (development)
APP_ENV=development
# Clé de signature des sessions Flask. Obligatoire en production ; générez-la avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacer-par-une-valeur-longue-et-aleatoire
# Adresse d'écoute du serveur de développement (127.0.0.1)
FLASK_HOST=127.0.0.1
# Port du serveur de développement (5000)
FLASK_PORT=5000
# Mode débogage de Flask, jamais en production (false)
FLASK_DEBUG=false
# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR (INFO)
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Fichiers et dossiers
# Base SQLite des commandes (orders.db)
DATABASE_PATH=orders.db
# Sauvegardes de la base (backups)
BACKUP_DIR=backups
# Exports Excel, CSV et PDF (exports)
EXPORT_DIR=exports
# Pièces jointes des emails (attachments)
ATTACHMENTS_DIR=attachments
# Médias reçus par WhatsApp (whatsapp_media)
WHATSAPP_MEDIA_DIR=whatsapp_media
# Base de connaissances en Markdown (knowledge)
KNOWLEDGE_DIR=knowledge

# ---------------------------------------------------------------- OpenAI
# Clé d'API OpenAI ; sans clé, l'extraction automatique est désactivée
OPENAI_API_KEY=sk-remplacer-par-votre-cle
# Modèle d'extraction des commandes (gpt-4o)
LLM_MODEL_EXTRACTION=gpt-4o
# Modèle léger : détection des renouvellements, classification (gpt-4o-mini)
LLM_MODEL_LIGHT=gpt-4o-mini
# Modèle de lecture du texte des images (gpt-4o)
LLM_MODEL_VISION=gpt-4o
# Modèle de transcription des notes vocales (whisper-1)
TRANSCRIPTION_MODEL=whisper-1
# Langue imposée à la transcription, code ISO 639-1 (fr, ar…) ; vide = détection automatique
TRANSCRIPTION_LANGUAGE=
# Modèle de calcul des vecteurs de la recherche documentaire (text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
# Température des modèles : basse pour des réponses stables (0.1)
LLM_TEMPERATURE=0.1
# Délai maximal d'un appel à l'API, en secondes (60)
LLM_TIMEOUT=60

# ---------------------------------------------------------------- Email (Gmail)
# Adresse de la boîte qui reçoit les commandes et envoie les notifications
GMAIL_EMAIL=commandes@example.com
# Mot de passe d'application Gmail (jamais le mot de passe du compte)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Serveur SMTP d'envoi (smtp.gmail.com)
SMTP_SERVER=smtp.gmail.com
# Port SMTP avec STARTTLS (587)
SMTP_PORT=587

# ---------------------------------------------------------------- WhatsApp (Twilio)
# Identifiant du compte Twilio (commence par AC)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Jeton d'authentification Twilio
TWILIO_AUTH_TOKEN=remplacer-par-votre-jeton
# Numéro WhatsApp d'envoi (whatsapp:+14155238886, numéro du bac à sable Twilio)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Vérification de la signature des requêtes Twilio sur le webhook (true)
TWILIO_VALIDATE_SIGNATURE=true
# Adresse publique du serveur (tunnel ngrok ou proxy inverse), sans / final ;
# l'URL du webhook à déclarer chez Twilio est PUBLIC_BASE_URL/webhook/whatsapp
PUBLIC_BASE_URL=https://exemple.ngrok-free.app
# Réponse WhatsApp envoyée en différé par l'API Twilio plutôt que dans la réponse au webhook (true)
WHATSAPP_ASYNC_REPLY=true
# Nombre maximal de messages traités par minute et par numéro (10)
WHATSAPP_RATE_LIMIT_PER_MINUTE=10
# Taille maximale d'un média téléchargé, en octets (16777216 = 16 Mo)
MAX_MEDIA_BYTES=16777216

# ---------------------------------------------------------------- Assistant et base de connaissances
# Assistant conversationnel sur WhatsApp (true)
CHATBOT_ENABLED=true
# Réponses fondées sur la base de connaissances, par génération augmentée par la recherche (true)
RAG_ENABLED=true
# Nombre d'extraits retenus par recherche (4)
RAG_TOP_K=4
# Score de similarité minimal pour répondre, entre 0 et 1 (0.25)
RAG_MIN_SCORE=0.25

# ---------------------------------------------------------------- Accès au tableau de bord
# Connexion obligatoire au tableau de bord (true)
AUTH_ENABLED=true
# Identifiant de l'administrateur (admin)
ADMIN_USERNAME=admin
# Empreinte (hachage) du mot de passe administrateur, produite par : python scripts/hash_password.py
# Sans empreinte, aucune connexion n'est possible. Mettez la valeur entre apostrophes :
# elle contient des caractères $ que certains outils (docker compose) interprètent.
ADMIN_PASSWORD_HASH=
# Nombre d'échecs de connexion tolérés par adresse IP avant blocage (5)
LOGIN_MAX_ATTEMPTS=5
# Durée du blocage après trop d'échecs, en minutes ; c'est aussi la période de comptage des échecs (15)
LOGIN_LOCKOUT_MINUTES=15
# Protection contre la falsification de requête intersite (CSRF, Cross-Site Request Forgery) :
# chaque requête qui modifie des données doit porter le jeton de la session (true)
CSRF_ENABLED=true
# Cookie de session envoyé uniquement en HTTPS ; vide = activé en production seulement
SESSION_COOKIE_SECURE=
# Faire confiance aux en-têtes X-Forwarded-For, X-Forwarded-Proto et X-Forwarded-Host
# (adresse du client, protocole et nom d'hôte d'origine). À activer uniquement derrière un
# proxy inverse (nginx, ngrok…) qui écrit ces en-têtes ; sinon un client pourrait les falsifier (false)
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------- Sauvegardes automatiques
# Planificateur de sauvegardes intégré à l'application (true)
BACKUP_SCHEDULER_ENABLED=true
# Intervalle entre deux sauvegardes, en heures (6)
BACKUP_INTERVAL_HOURS=6
# Nombre de sauvegardes conservées (20)
BACKUP_KEEP=20
