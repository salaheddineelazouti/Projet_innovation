# Secrets et environnements locaux (NE JAMAIS VERSER AU DÉPÔT) : .env et ses variantes
# (.env.production, .env.local…), sauf le modèle .env.example
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Bases de données SQLite, quel que soit leur nom ou leur dossier (elles contiennent des données
# clients), avec leurs fichiers de journal
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.gz

# Sauvegardes (peuvent être volumineuses)
backups/*
!backups/.gitkeep

# Médias téléchargés
whatsapp_media/*
!whatsapp_media/.gitkeep
attachments/*
!attachments/.gitkeep

# Exports générés
exports/*
!exports/.gitkeep

# Fichiers système
.DS_Store
Thumbs.db

# Tunnel ngrok
ngrok.exe
ngrok

# Sorties de traitement contenant des données de clients
orders_output.json

# Données locales (base, sauvegardes, médias hors des dossiers par défaut)
/data/

# Outils de qualité et de test
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Paquets construits
build/
dist/
*.egg-info/
